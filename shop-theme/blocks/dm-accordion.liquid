{%- comment -%}
  `accordion` — thin shim. The markup lives in snippets/dm-atom-accordion.liquid,
  shared with the inline emitter so a deep tree renders identically without
  spending a block level. This file owns only what a snippet CAN'T do:
  `content_for` (template-source-only) and the schema block.
{%- endcomment -%}
{%- capture children -%}
  {% content_for 'blocks' %}
  {{ block.settings.dm_inline_children }}
{%- endcapture -%}
{% render 'dm-atom-accordion',
  variant: block.settings.variant,
  size: block.settings.size,
  size_sm: block.settings.size_sm,
  allow_multiple_open: block.settings.allow_multiple_open,
  gap: block.settings.gap,
  margin_top: block.settings.margin_top,
  margin_top_sm: block.settings.margin_top_sm,
  custom_styles_attrs: block.settings.custom_styles_attrs,
  custom_styles_inline: block.settings.custom_styles_inline,
  shopify_attributes: block.shopify_attributes,
  children: children %}

{% schema %}
{
  "name": "DM Accordion",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "variant",
      "label": "Variant",
      "options": [
        { "label": "Default", "value": "default" },
        { "label": "Ghost", "value": "ghost" },
        { "label": "Minimal", "value": "minimal" }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "options": [
        { "label": "SM", "value": "sm" },
        { "label": "MD", "value": "md" },
        { "label": "LG", "value": "lg" }
      ],
      "default": "md"
    },
    {
      "type": "select",
      "id": "size_sm",
      "label": "Size (Mobile)",
      "options": [
        { "label": "—", "value": "" },
        { "label": "SM", "value": "sm" },
        { "label": "MD", "value": "md" },
        { "label": "LG", "value": "lg" }
      ],
      "default": ""
    },
    {
      "type": "select",
      "id": "allow_multiple_open",
      "label": "Allow multiple open",
      "options": [
        { "label": "False", "value": "false" },
        { "label": "True", "value": "true" }
      ],
      "default": "false"
    },
    {
      "type": "select",
      "id": "gap",
      "label": "Gap",
      "options": [
        { "label": "0", "value": "0" },
        { "label": "1", "value": "1" },
        { "label": "2", "value": "2" },
        { "label": "4", "value": "4" },
        { "label": "6", "value": "6" }
      ],
      "default": "2"
    },
    {
      "type": "text",
      "id": "margin_top",
      "label": "Margin Top"
    },
    {
      "type": "text",
      "id": "margin_top_sm",
      "label": "Margin Top (Mobile)"
    },
        {
      "type": "textarea",
      "id": "custom_styles_attrs",
      "label": "Custom styles — data attributes (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    },
    {
      "type": "textarea",
      "id": "custom_styles_inline",
      "label": "Custom styles — inline CSS (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    },
    {
      "type": "liquid",
      "id": "dm_inline_children",
      "label": "Inlined children (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    }
  ],
  "presets": [
    { "name": "DM Accordion" }
  ],
  "blocks": [
    { "type": "dm-accordion-item" }
  ]
}
{% endschema %}
