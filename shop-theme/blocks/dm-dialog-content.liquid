{%- comment -%}
  `dialog-content` — thin shim. The markup lives in snippets/dm-atom-dialog-content.liquid,
  shared with the inline emitter so a deep tree renders identically without
  spending a block level. This file owns only what a snippet CAN'T do:
  `content_for` (template-source-only) and the schema block.
{%- endcomment -%}
{%- capture children -%}
  {% content_for 'blocks' %}
  {{ block.settings.dm_inline_children }}
{%- endcapture -%}
{% render 'dm-atom-dialog-content',
  bg: block.settings.bg,
  shopify_attributes: block.shopify_attributes,
  children: children %}

{% schema %}
{
  "name": "DM Dialog Content",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "bg",
      "label": "Background",
      "info": "Modal-box background. Empty = variant default. Any CSS color or var(--dm-X)."
    },
    {
      "type": "liquid",
      "id": "dm_inline_children",
      "label": "Inlined children (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    }
  ],
  "blocks": [
    { "type": "@theme" }
  ]
}
{% endschema %}
