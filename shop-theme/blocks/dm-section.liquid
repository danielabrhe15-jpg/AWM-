{%- comment -%}
  Body section (a block of dm-page). The render body lives in the shared
  snippet `dm-section-render` (also used by sections/dm-section.liquid for
  header / footer group sections) — keep section markup changes there, not
  here. This file owns only the {% schema %} (Shopify can't share schema).
{%- endcomment -%}
{%- capture children -%}
  {% content_for 'blocks' %}
{%- endcapture -%}
{% render 'dm-section-render',
  s: block.settings,
  children: children,
  shopify_attributes: block.shopify_attributes %}

