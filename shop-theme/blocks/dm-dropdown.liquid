{%- comment -%}
  `dropdown` — thin shim. The markup lives in snippets/dm-atom-dropdown.liquid,
  shared with the inline emitter so a deep tree renders identically without
  spending a block level. This file owns only what a snippet CAN'T do:
  `content_for` (template-source-only) and the schema block.
{%- endcomment -%}
{%- capture item_template -%}
  {% content_for 'blocks' %}
  {{ block.settings.dm_inline_item_template }}
{%- endcapture -%}
{% render 'dm-atom-dropdown',
  source: block.settings.source,
  option: block.settings.option,
  size: block.settings.size,
  size_sm: block.settings.size_sm,
  bg: block.settings.bg,
  color: block.settings.color,
  border_color: block.settings.border_color,
  border_width: block.settings.border_width,
  radius: block.settings.radius,
  shopify_attributes: block.shopify_attributes,
  item_template: item_template %}

{% schema %}
{
  "name": "DM Dropdown",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "source",
      "label": "Source",
      "options": [
        { "label": "Option", "value": "option" },
        { "label": "Selling plan", "value": "selling_plan" }
      ],
      "default": "option"
    },
    {
      "type": "select",
      "id": "option",
      "label": "Option",
      "options": [
        { "label": "Option 1", "value": "option_1" },
        { "label": "Option 2", "value": "option_2" },
        { "label": "Option 3", "value": "option_3" }
      ],
      "default": "option_1"
    },
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "options": [
        { "label": "Small", "value": "sm" },
        { "label": "Medium", "value": "md" },
        { "label": "Large", "value": "lg" }
      ],
      "default": "md"
    },
    {
      "type": "select",
      "id": "size_sm",
      "label": "Size (Mobile)",
      "options": [
        { "label": "—", "value": "" },
        { "label": "Small", "value": "sm" },
        { "label": "Medium", "value": "md" },
        { "label": "Large", "value": "lg" }
      ],
      "default": ""
    },
    { "type": "text", "id": "bg", "label": "Background" },
    { "type": "text", "id": "color", "label": "Text color" },
    { "type": "text", "id": "border_color", "label": "Border color" },
    { "type": "text", "id": "border_width", "label": "Border width", "default": "1px" },
    { "type": "text", "id": "radius", "label": "Radius", "default": "var(--dm-radius-md)" },
    {
      "type": "liquid",
      "id": "dm_inline_item_template",
      "label": "Inlined item_template (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    }
  ],
  "presets": [
    { "name": "DM Dropdown" }
  ],
  "blocks": [
    { "type": "@theme" }
  ]
}
{% endschema %}
