{%- comment -%}
  `tabs` — thin shim. The markup lives in snippets/dm-atom-tabs.liquid,
  shared with the inline emitter so a deep tree renders identically without
  spending a block level. This file owns only what a snippet CAN'T do:
  `content_for` (template-source-only) and the schema block.
{%- endcomment -%}
{%- capture children -%}
  {% content_for 'blocks' %}
  {{ block.settings.dm_inline_children }}
{%- endcapture -%}
{% render 'dm-atom-tabs',
  variant: block.settings.variant,
  orientation: block.settings.orientation,
  align: block.settings.align,
  default_value: block.settings.default_value,
  margin_top: block.settings.margin_top,
  margin_top_sm: block.settings.margin_top_sm,
  custom_styles_attrs: block.settings.custom_styles_attrs,
  custom_styles_inline: block.settings.custom_styles_inline,
  shopify_attributes: block.shopify_attributes,
  children: children %}

{% schema %}
{
  "name": "DM Tabs",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "variant",
      "label": "Variant",
      "options": [
        {
          "label": "Default",
          "value": "default"
        },
        {
          "label": "Line",
          "value": "line"
        },
        {
          "label": "Pills",
          "value": "pills"
        },
        {
          "label": "Boxed",
          "value": "boxed"
        }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "orientation",
      "label": "Orientation",
      "options": [
        {
          "label": "Horizontal",
          "value": "horizontal"
        },
        {
          "label": "Vertical",
          "value": "vertical"
        }
      ],
      "default": "horizontal"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Align",
      "options": [
        {
          "label": "Start",
          "value": "start"
        },
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "End",
          "value": "end"
        },
        {
          "label": "Stretch",
          "value": "stretch"
        }
      ],
      "default": "start"
    },
    {
      "type": "text",
      "id": "default_value",
      "label": "Default Value"
    },
    {
      "type": "text",
      "id": "margin_top",
      "label": "Margin Top"
    },
    {
      "type": "text",
      "id": "margin_top_sm",
      "label": "Margin Top (Mobile)"
    },
        {
      "type": "textarea",
      "id": "custom_styles_attrs",
      "label": "Custom styles — data attributes (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    },
    {
      "type": "textarea",
      "id": "custom_styles_inline",
      "label": "Custom styles — inline CSS (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    },
    {
      "type": "liquid",
      "id": "dm_inline_children",
      "label": "Inlined children (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    }
  ],
  "presets": [
    {
      "name": "DM Tabs"
    }
  ],
  "blocks": [
    {
      "type": "dm-tabs-list"
    },
    {
      "type": "dm-tabs-panel"
    }
  ]
}
{% endschema %}
