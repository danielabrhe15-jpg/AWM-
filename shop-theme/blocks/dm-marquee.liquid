{%- comment -%}
  `marquee` — thin shim. The markup lives in snippets/dm-atom-marquee.liquid,
  shared with the inline emitter so a deep tree renders identically without
  spending a block level. This file owns only what a snippet CAN'T do:
  `content_for` (template-source-only) and the schema block.
{%- endcomment -%}
{%- capture children -%}
  {% content_for 'blocks' %}
  {{ block.settings.dm_inline_children }}
{%- endcapture -%}
{% render 'dm-atom-marquee',
  speed: block.settings.speed,
  direction: block.settings.direction,
  pause_on_hover: block.settings.pause_on_hover,
  gap: block.settings.gap,
  fade: block.settings.fade,
  margin_top: block.settings.margin_top,
  margin_top_sm: block.settings.margin_top_sm,
  custom_styles_attrs: block.settings.custom_styles_attrs,
  custom_styles_inline: block.settings.custom_styles_inline,
  shopify_attributes: block.shopify_attributes,
  children: children %}

{% schema %}
{
  "name": "DM Marquee",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "speed",
      "label": "Speed",
      "default": "normal"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "options": [
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Right",
          "value": "right"
        },
        {
          "label": "Up",
          "value": "up"
        },
        {
          "label": "Down",
          "value": "down"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "pause_on_hover",
      "label": "Pause on Hover",
      "options": [
        {
          "label": "True",
          "value": "true"
        },
        {
          "label": "False",
          "value": "false"
        }
      ],
      "default": "true"
    },
    {
      "type": "select",
      "id": "gap",
      "label": "Gap",
      "options": [
        {
          "label": "0",
          "value": "0"
        },
        {
          "label": "1",
          "value": "1"
        },
        {
          "label": "2",
          "value": "2"
        },
        {
          "label": "4",
          "value": "4"
        },
        {
          "label": "6",
          "value": "6"
        },
        {
          "label": "8",
          "value": "8"
        }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "fade",
      "label": "Fade",
      "options": [
        {
          "label": "None",
          "value": "none"
        },
        {
          "label": "Light",
          "value": "light"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Strong",
          "value": "strong"
        }
      ],
      "default": "medium"
    },
    {
      "type": "text",
      "id": "margin_top",
      "label": "Margin Top"
    },
    {
      "type": "text",
      "id": "margin_top_sm",
      "label": "Margin Top (Mobile)"
    },
        {
      "type": "textarea",
      "id": "custom_styles_attrs",
      "label": "Custom styles — data attributes (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    },
    {
      "type": "textarea",
      "id": "custom_styles_inline",
      "label": "Custom styles — inline CSS (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    },
    {
      "type": "liquid",
      "id": "dm_inline_children",
      "label": "Inlined children (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    }
  ],
  "presets": [
    {
      "name": "DM Marquee"
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    }
  ]
}
{% endschema %}
