        { "label": "5", "value": "5" },
        { "label": "6", "value": "6" },
        { "label": "8", "value": "8" },
        { "label": "10", "value": "10" },
        { "label": "12", "value": "12" },
        { "label": "16", "value": "16" },
        { "label": "20", "value": "20" },
        { "label": "24", "value": "24" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "gap_sm",
      "label": "Gap (Mobile)",
      "options": [
        { "label": "—", "value": "" },
        { "label": "0", "value": "0" },
        { "label": "1", "value": "1" },
        { "label": "2", "value": "2" },
        { "label": "3", "value": "3" },
        { "label": "4", "value": "4" },
        { "label": "5", "value": "5" },
        { "label": "6", "value": "6" },
        { "label": "8", "value": "8" },
        { "label": "10", "value": "10" },
        { "label": "12", "value": "12" },
        { "label": "16", "value": "16" },
        { "label": "20", "value": "20" },
        { "label": "24", "value": "24" }
      ],
      "default": ""
    },
    {
      "type": "select",
      "id": "align",
      "label": "Align",
      "options": [
        { "label": "Start", "value": "start" },
        { "label": "Center", "value": "center" },
        { "label": "End", "value": "end" },
        { "label": "Stretch", "value": "stretch" }
      ],
      "default": "stretch"
    },
    {
      "type": "select",
      "id": "align_sm",
      "label": "Align (Mobile)",
      "options": [
        { "label": "—", "value": "" },
        { "label": "Start", "value": "start" },
