        { "label": "Row", "value": "row" }
      ],
      "default": "column"
    },
    {
      "type": "select",
      "id": "direction_sm",
      "label": "Direction (Mobile)",
      "options": [
        { "label": "—", "value": "" },
        { "label": "Column", "value": "column" },
        { "label": "Row", "value": "row" }
