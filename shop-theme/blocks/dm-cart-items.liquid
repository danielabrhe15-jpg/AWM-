{%- comment -%}
  `cart-items` — thin shim. The markup lives in snippets/dm-atom-cart-items.liquid,
  shared with the inline emitter so a deep tree renders identically without
  spending a block level. This file owns only what a snippet CAN'T do:
  `content_for` (template-source-only) and the schema block.
{%- endcomment -%}
{%- capture item_template -%}
  {% content_for 'blocks' %}
  {{ block.settings.dm_inline_item_template }}
{%- endcapture -%}
{% render 'dm-atom-cart-items',
  direction: block.settings.direction,
  direction_sm: block.settings.direction_sm,
  gap: block.settings.gap,
  gap_sm: block.settings.gap_sm,
  align: block.settings.align,
  align_sm: block.settings.align_sm,
  item_attrs: block.settings.item_attrs,
  item_inline: block.settings.item_inline,
  custom_styles_attrs: block.settings.custom_styles_attrs,
  custom_styles_inline: block.settings.custom_styles_inline,
  shopify_attributes: block.shopify_attributes,
  item_template: item_template %}

{% schema %}
{
  "name": "DM Cart Items",
  "tag": null,
  "settings": [
    { "type": "header", "content": "Outer layout" },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
