{%- comment -%}
  `comparison-row` (type `ComparisonRow`) — thin shim. The markup lives in
  snippets/dm-atom-comparison-row.liquid, shared with the inline emitter so a
  deep tree renders identically without spending a block level. This file owns
  only what a snippet CAN'T do: `content_for` and the schema block.
{%- endcomment -%}
{%- capture children -%}
  {% content_for 'blocks' %}
  {{ block.settings.dm_inline_children }}
{%- endcapture -%}
{% render 'dm-atom-comparison-row',
  kind: block.settings.kind,
  shopify_attributes: block.shopify_attributes,
  children: children %}

{% schema %}
{
  "name": "DM Comparison Row",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "kind",
      "label": "Row type",
      "options": [
        { "label": "Header", "value": "header" },
        { "label": "Body", "value": "body" },
        { "label": "Footer", "value": "footer" }
      ],
      "default": "body"
    },
    {
      "type": "liquid",
      "id": "dm_inline_children",
      "label": "Inlined children (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    }
  ],
  "blocks": [
    { "type": "dm-comparison-cell" }
  ]
}
{% endschema %}
