{%- comment -%}
  `card` — thin shim. The markup lives in snippets/dm-atom-card.liquid,
  shared with the inline emitter so a deep tree renders identically without
  spending a block level. This file owns only what a snippet CAN'T do:
  `content_for` (template-source-only) and the schema block.
{%- endcomment -%}
{%- capture children -%}
  {% content_for 'blocks' %}
  {{ block.settings.dm_inline_children }}
{%- endcapture -%}
{% render 'dm-atom-card',
  bind: block.settings.bind,
  picker_option: block.settings.picker_option,
  swatch: block.settings.swatch,
  bar_id: block.settings.bar_id,
  picker_kind: block.settings.picker_kind,
  combination: block.settings.combination,
  padding: block.settings.padding,
  padding_sm: block.settings.padding_sm,
  direction: block.settings.direction,
  direction_sm: block.settings.direction_sm,
  gap: block.settings.gap,
  gap_sm: block.settings.gap_sm,
  align: block.settings.align,
  align_sm: block.settings.align_sm,
  justify: block.settings.justify,
  justify_sm: block.settings.justify_sm,
  columns: block.settings.columns,
  columns_sm: block.settings.columns_sm,
  wrap: block.settings.wrap,
  wrap_sm: block.settings.wrap_sm,
  radius: block.settings.radius,
  bg: block.settings.bg,
  ring_width: block.settings.ring_width,
  ring_color: block.settings.ring_color,
  shadow: block.settings.shadow,
  margin_top: block.settings.margin_top,
  margin_top_sm: block.settings.margin_top_sm,
  custom_styles_attrs: block.settings.custom_styles_attrs,
  custom_styles_inline: block.settings.custom_styles_inline,
  shopify_attributes: block.shopify_attributes,
  children: children %}

