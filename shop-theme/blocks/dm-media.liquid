        {
          "label": "Auto",
          "value": "auto"
        },
        {
          "label": "1/1",
          "value": "1/1"
        },
        {
          "label": "4/3",
          "value": "4/3"
        },
        {
          "label": "3/2",
          "value": "3/2"
        },
        {
          "label": "16/9",
          "value": "16/9"
        },
        {
          "label": "2/1",
          "value": "2/1"
        },
        {
          "label": "2/3",
          "value": "2/3"
        },
        {
          "label": "3/4",
          "value": "3/4"
        }
      ],
      "default": "1/1"
    },
    {
      "type": "select",
      "id": "aspect_ratio_sm",
      "label": "Ratio (Mobile)",
      "options": [
        {
          "label": "—",
          "value": ""
        },
        {
          "label": "Auto",
          "value": "auto"
        },
        {
          "label": "1/1",
          "value": "1/1"
        },
        {
          "label": "4/3",
          "value": "4/3"
        },
        {
          "label": "3/2",
          "value": "3/2"
        },
        {
          "label": "16/9",
          "value": "16/9"
        },
        {
          "label": "2/1",
          "value": "2/1"
        },
        {
          "label": "2/3",
          "value": "2/3"
        },
        {
          "label": "3/4",
          "value": "3/4"
        }
      ],
      "default": ""
    },
    {
      "type": "number",
      "id": "max_width",
      "label": "Max Width"
    },
    {
      "type": "number",
      "id": "height",
      "label": "Height"
    },
    {
      "type": "select",
      "id": "object_position",
      "label": "Position",
      "options": [
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Top",
          "value": "top"
        },
        {
          "label": "Bottom",
          "value": "bottom"
        },
        {
