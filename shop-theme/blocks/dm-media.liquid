    },
    {
      "type": "text",
      "id": "slide_variant_ids",
      "label": "Slide variant ids (auto)",
      "info": "Comma-separated variant ids this gallery slide is the featured image for — stamped at publish. Read by the variant→carousel sync. Replaced product_media_pos, which resolved a position against the live product's media order and broke whenever that order diverged."
    },
    {
      "type": "text",
      "id": "margin_top",
      "label": "Margin Top"
    },
    {
      "type": "text",
      "id": "margin_top_sm",
      "label": "Margin Top (Mobile)"
    },
        {
      "type": "textarea",
      "id": "custom_styles_attrs",
