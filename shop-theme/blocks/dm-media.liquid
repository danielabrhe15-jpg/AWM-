{%- comment -%}
  `media` — thin shim. The markup lives in snippets/dm-atom-media.liquid,
  shared with the inline emitter so a deep tree renders identically without
  spending a block level. This file owns only what a snippet CAN'T do:
  `content_for` (template-source-only) and the schema block.
{%- endcomment -%}
{% render 'dm-atom-media',
  src: block.settings.src,
  alt: block.settings.alt,
  poster: block.settings.poster,
  aspect_ratio: block.settings.aspect_ratio,
  aspect_ratio_sm: block.settings.aspect_ratio_sm,
  max_width: block.settings.max_width,
  height: block.settings.height,
  object_position: block.settings.object_position,
  radius: block.settings.radius,
  border_width: block.settings.border_width,
  border_color: block.settings.border_color,
  shadow: block.settings.shadow,
  overlay: block.settings.overlay,
  video_style: block.settings.video_style,
  bind: block.settings.bind,
  slide_variant_ids: block.settings.slide_variant_ids,
  product_media_pos: block.settings.product_media_pos,
  margin_top: block.settings.margin_top,
  margin_top_sm: block.settings.margin_top_sm,
  custom_styles_attrs: block.settings.custom_styles_attrs,
  custom_styles_inline: block.settings.custom_styles_inline,
  shopify_attributes: block.shopify_attributes %}

{% schema %}
{
  "name": "DM Media",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "src",
