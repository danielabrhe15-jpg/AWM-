    {
      "type": "text",
      "id": "alt",
      "label": "Alt Text",
      "default": "auto"
    },
    {
      "type": "text",
      "id": "poster",
      "label": "Video Poster",
      "default": "auto"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Ratio",
