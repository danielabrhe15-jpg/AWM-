{%- comment -%}
  `sheet` — thin shim. The markup lives in snippets/dm-atom-sheet.liquid,
  shared with the inline emitter so a deep tree renders identically without
  spending a block level. This file owns only what a snippet CAN'T do:
  `content_for` (template-source-only) and the schema block.
{%- endcomment -%}
{%- capture trigger_html -%}
  {% content_for 'block', type: 'dm-sheet-trigger', id: 'trigger' %}
  {{ block.settings.dm_inline_trigger_html }}
{%- endcapture -%}
{%- capture content_html -%}
  {% content_for 'block', type: 'dm-sheet-content', id: 'content' %}
  {{ block.settings.dm_inline_content_html }}
{%- endcapture -%}
{%- capture empty_content_html -%}
  {% content_for 'block', type: 'dm-sheet-content', id: 'emptyContent' %}
  {{ block.settings.dm_inline_empty_content_html }}
{%- endcapture -%}
{% render 'dm-atom-sheet',
  open_on: block.settings.open_on,
  combination: block.settings.combination,
  has_empty: block.settings.has_empty,
  side: block.settings.side,
  size: block.settings.size,
  animation: block.settings.animation,
  closing_icon: block.settings.closing_icon,
  overlay_color: block.settings.overlay_color,
  custom_styles_attrs: block.settings.custom_styles_attrs,
  custom_styles_inline: block.settings.custom_styles_inline,
  shopify_attributes: block.shopify_attributes,
  trigger_html: trigger_html,
  content_html: content_html,
  empty_content_html: empty_content_html %}

{% schema %}
{
  "name": "DM Sheet",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "open_on",
      "label": "Open on",
      "options": [
        { "label": "Trigger", "value": "trigger" },
        { "label": "Cart", "value": "cart" }
      ],
      "default": "trigger"
    },
    {
      "type": "select",
      "id": "combination",
      "label": "Color Scheme",
      "options": [
        { "label": "White", "value": "white" },
        { "label": "Light", "value": "light" },
        { "label": "Neutral", "value": "neutral" },
        { "label": "Tinted", "value": "tinted" },
        { "label": "Tinted secondary", "value": "tinted-secondary" },
        { "label": "Vibrant", "value": "vibrant" },
        { "label": "Dark", "value": "dark" },
        { "label": "Gradient", "value": "gradient" }
      ],
      "default": "white"
    },
    {
      "type": "checkbox",
      "id": "has_empty",
      "label": "Has empty-cart body",
      "info": "Managed by DropMagic — set at publish when an empty-cart drawer body exists.",
      "default": false
    },
    {
      "type": "select",
      "id": "side",
      "label": "Side",
      "options": [
        { "label": "Left", "value": "left" },
        { "label": "Right", "value": "right" },
        { "label": "Top", "value": "top" },
        { "label": "Bottom", "value": "bottom" }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "options": [
        { "label": "Sm", "value": "sm" },
        { "label": "Md", "value": "md" },
        { "label": "Lg", "value": "lg" },
        { "label": "Xl", "value": "xl" }
      ],
      "default": "md"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "Animation",
      "options": [
        { "label": "Instant", "value": "instant" },
        { "label": "Snappy", "value": "snappy" },
        { "label": "Normal", "value": "normal" },
        { "label": "Long", "value": "long" }
      ],
      "default": "normal"
    },
    {
      "type": "text",
      "id": "closing_icon",
      "label": "Close icon",
      "info": "Empty hides the close button; any non-empty value shows a ✕ close button.",
      "default": "cross"
    },
    {
      "type": "text",
      "id": "overlay_color",
      "label": "Overlay color",
      "info": "Backdrop color behind the drawer. Empty = default. Any CSS color."
    },
        {
      "type": "textarea",
      "id": "custom_styles_attrs",
      "label": "Custom styles — data attributes (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    },
    {
      "type": "textarea",
      "id": "custom_styles_inline",
      "label": "Custom styles — inline CSS (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    },
    {
      "type": "liquid",
      "id": "dm_inline_trigger_html",
      "label": "Inlined trigger_html (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    },
    {
      "type": "liquid",
      "id": "dm_inline_content_html",
      "label": "Inlined content_html (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    },
    {
      "type": "liquid",
      "id": "dm_inline_empty_content_html",
      "label": "Inlined empty_content_html (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    }
  ],
  "blocks": [
    { "type": "@theme" }
  ],
  "presets": [
    { "name": "DM Sheet" }
  ]
}
{% endschema %}
