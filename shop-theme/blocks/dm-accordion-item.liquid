{%- comment -%}
  `accordion-item` — thin shim. The markup lives in snippets/dm-atom-accordion-item.liquid,
  shared with the inline emitter so a deep tree renders identically without
  spending a block level. This file owns only what a snippet CAN'T do:
  `content_for` (template-source-only) and the schema block.
{%- endcomment -%}
{%- capture children -%}
  {% content_for 'blocks' %}
  {{ block.settings.dm_inline_children }}
{%- endcapture -%}
{% render 'dm-atom-accordion-item',
  value: block.settings.value,
  default_open: block.settings.default_open,
  bg: block.settings.bg,
  border_color: block.settings.border_color,
  block_id: block.id,
  shopify_attributes: block.shopify_attributes,
  children: children %}

{% schema %}
{
  "name": "DM Accordion Item",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "value",
      "label": "Value"
    },
    {
      "type": "select",
      "id": "default_open",
      "label": "Default Open",
      "options": [
        {
          "label": "False",
          "value": "false"
        },
        {
          "label": "True",
          "value": "true"
        }
      ],
      "default": "false"
    },
    {
      "type": "text",
      "id": "bg",
      "label": "Background",
      "info": "Any CSS color — hex, rgb, oklch, var(--dm-X). Empty = inherit variant default."
    },
    {
      "type": "text",
      "id": "border_color",
      "label": "Border color",
      "info": "Any CSS color or var(--dm-X). Empty = inherit theme `--dm-border`."
    },
    {
      "type": "liquid",
      "id": "dm_inline_children",
      "label": "Inlined children (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    }
  ],
  "blocks": [
    {
      "type": "dm-accordion-trigger"
    },
    {
      "type": "dm-accordion-content"
    }
  ]
}
{% endschema %}
