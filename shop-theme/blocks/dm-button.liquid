{%- comment -%}
  `button` — thin shim. The markup lives in snippets/dm-atom-button.liquid,
  shared with the inline emitter so a deep tree renders identically without
  spending a block level. This file owns only what a snippet CAN'T do:
  `content_for` (template-source-only) and the schema block.
{%- endcomment -%}
{%- capture children -%}
  {% content_for 'blocks' %}
  {{ block.settings.dm_inline_children }}
{%- endcapture -%}
{% render 'dm-atom-button',
  action: block.settings.action,
  variant: block.settings.variant,
  size: block.settings.size,
  size_sm: block.settings.size_sm,
  href: block.settings.href,
  target: block.settings.target,
  width: block.settings.width,
  width_sm: block.settings.width_sm,
  direction: block.settings.direction,
  bg: block.settings.bg,
  color: block.settings.color,
  radius: block.settings.radius,
  border_width: block.settings.border_width,
  border_color: block.settings.border_color,
  shadow: block.settings.shadow,
  margin_top: block.settings.margin_top,
  margin_top_sm: block.settings.margin_top_sm,
  bind: block.settings.bind,
  custom_styles_attrs: block.settings.custom_styles_attrs,
  custom_styles_inline: block.settings.custom_styles_inline,
  shopify_attributes: block.shopify_attributes,
  children: children %}

