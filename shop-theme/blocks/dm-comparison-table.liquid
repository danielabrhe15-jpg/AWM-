{%- comment -%}
  `comparison-table` — thin shim. The markup lives in
  snippets/dm-atom-comparison-table.liquid, shared with the inline emitter so a
  deep tree renders identically without spending a block level. This file owns
  only what a snippet CAN'T do: `content_for` (template-source-only) and the
  schema block.
{%- endcomment -%}
{%- capture children -%}
  {% content_for 'blocks' %}
  {{ block.settings.dm_inline_children }}
{%- endcapture -%}
{% render 'dm-atom-comparison-table',
  columns: block.settings.columns,
  highlight_column: block.settings.highlight_column,
  highlight_style: block.settings.highlight_style,
  variant: block.settings.variant,
  size: block.settings.size,
  size_sm: block.settings.size_sm,
  highlight_color: block.settings.highlight_color,
  margin_top: block.settings.margin_top,
  margin_top_sm: block.settings.margin_top_sm,
  custom_styles_attrs: block.settings.custom_styles_attrs,
  custom_styles_inline: block.settings.custom_styles_inline,
  shopify_attributes: block.shopify_attributes,
  children: children %}

{% schema %}
{
  "name": "DM Comparison Table",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "options": [
        { "label": "2", "value": "2" },
        { "label": "3", "value": "3" },
        { "label": "4", "value": "4" },
        { "label": "5", "value": "5" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "highlight_column",
      "label": "Featured column",
      "options": [
        { "label": "None", "value": "0" },
        { "label": "1", "value": "1" },
        { "label": "2", "value": "2" },
        { "label": "3", "value": "3" },
        { "label": "4", "value": "4" },
        { "label": "5", "value": "5" }
      ],
      "default": "0"
    },
    {
      "type": "select",
      "id": "highlight_style",
      "label": "Featured style",
      "options": [
        { "label": "Tint", "value": "tint" },
        { "label": "Card", "value": "card" }
      ],
      "default": "tint"
    },
    {
      "type": "select",
      "id": "variant",
      "label": "Variant",
      "options": [
        { "label": "Lines", "value": "lines" },
        { "label": "Striped", "value": "striped" },
        { "label": "Borderless", "value": "borderless" }
      ],
      "default": "lines"
    },
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "options": [
        { "label": "SM", "value": "sm" },
        { "label": "MD", "value": "md" },
        { "label": "LG", "value": "lg" }
      ],
      "default": "md"
    },
    {
      "type": "select",
      "id": "size_sm",
      "label": "Size (Mobile)",
      "options": [
        { "label": "—", "value": "" },
        { "label": "SM", "value": "sm" },
        { "label": "MD", "value": "md" },
        { "label": "LG", "value": "lg" }
      ],
      "default": ""
    },
    {
      "type": "text",
      "id": "highlight_color",
      "label": "Featured color",
      "info": "Any CSS color or gradient. Empty = soft primary tint (tint) / card surface (card)."
    },
    {
      "type": "text",
      "id": "margin_top",
      "label": "Margin Top"
    },
    {
      "type": "text",
      "id": "margin_top_sm",
      "label": "Margin Top (Mobile)"
    },
    {
      "type": "textarea",
      "id": "custom_styles_attrs",
      "label": "Custom styles — data attributes (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    },
    {
      "type": "textarea",
      "id": "custom_styles_inline",
      "label": "Custom styles — inline CSS (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    },
    {
      "type": "liquid",
      "id": "dm_inline_children",
      "label": "Inlined children (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    }
  ],
  "presets": [
    { "name": "DM Comparison Table" }
  ],
  "blocks": [
    { "type": "dm-comparison-row" }
  ]
}
{% endschema %}
