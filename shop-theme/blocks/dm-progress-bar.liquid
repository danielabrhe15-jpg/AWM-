{%- comment -%}
  `progress-bar` — thin shim. The markup lives in snippets/dm-atom-progress-bar.liquid,
  shared with the inline emitter so a deep tree renders identically without
  spending a block level. This file owns only what a snippet CAN'T do:
  `content_for` (template-source-only) and the schema block.
{%- endcomment -%}
{% render 'dm-atom-progress-bar',
  source: block.settings.source,
  duration_seconds: block.settings.duration_seconds,
  value: block.settings.value,
  progress_direction: block.settings.progress_direction,
  size: block.settings.size,
  radius: block.settings.radius,
  track_color: block.settings.track_color,
  fill_color: block.settings.fill_color,
  custom_styles_attrs: block.settings.custom_styles_attrs,
  custom_styles_inline: block.settings.custom_styles_inline,
  shopify_attributes: block.shopify_attributes %}

{% schema %}
{
  "name": "DM Progress Bar",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "source",
      "label": "Source",
      "options": [
        { "label": "Duration (countdown)", "value": "duration" },
        { "label": "Cart goal (free shipping)", "value": "cart-goal" },
        { "label": "Static (fixed value)", "value": "static" }
      ],
      "default": "duration"
    },
    {
      "type": "number",
      "id": "duration_seconds",
      "label": "Duration (seconds)",
      "default": 3600
    },
    {
      "type": "number",
      "id": "value",
      "label": "Value (%)",
      "info": "Fixed fill percentage (0–100) for the Static source.",
      "default": 50
    },
    {
      "type": "select",
      "id": "progress_direction",
      "label": "Direction",
      "options": [
        {
          "label": "Drain (100% → 0%)",
          "value": "drain"
        },
        {
          "label": "Fill (0% → 100%)",
          "value": "fill"
        }
      ],
      "default": "drain"
    },
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "options": [
        {
          "label": "xs (4px)",
          "value": "xs"
        },
        {
          "label": "sm (6px)",
          "value": "sm"
        },
        {
          "label": "md (8px)",
          "value": "md"
        },
        {
          "label": "lg (12px)",
          "value": "lg"
        }
      ],
      "default": "md"
    },
    {
      "type": "text",
      "id": "radius",
      "label": "Radius",
      "info": "Border radius — `9999px` for pill (default), `var(--dm-radius-{xs,sm,md,lg,xl})` for theme-linked, `0` for square. Empty = inherit theme.",
      "default": "9999px"
    },
    {
      "type": "text",
      "id": "track_color",
      "label": "Track color (paint string)",
      "info": "Empty = theme default. Accepts var(--dm-...), hex, oklch, or any CSS gradient."
    },
    {
      "type": "text",
      "id": "fill_color",
      "label": "Fill color (paint string)",
      "info": "Empty = theme default. Accepts var(--dm-...), hex, oklch, or any CSS gradient."
    },
        {
      "type": "textarea",
      "id": "custom_styles_attrs",
      "label": "Custom styles — data attributes (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    },
    {
      "type": "textarea",
      "id": "custom_styles_inline",
      "label": "Custom styles — inline CSS (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    }
  ],
  "presets": [
    {
      "name": "DM Progress Bar"
    }
  ]
}
{% endschema %}
