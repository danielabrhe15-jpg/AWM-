{%- comment -%}
  `before-after` — thin shim. The markup lives in snippets/dm-atom-before-after.liquid,
  shared with the inline emitter so a deep tree renders identically without
  spending a block level. This file owns only what a snippet CAN'T do:
  `content_for` (template-source-only) and the schema block.
{%- endcomment -%}
{% render 'dm-atom-before-after',
  image_before: block.settings.image_before,
  image_after: block.settings.image_after,
  variant: block.settings.variant,
  aspect_ratio: block.settings.aspect_ratio,
  radius: block.settings.radius,
  line_color: block.settings.line_color,
  custom_styles_attrs: block.settings.custom_styles_attrs,
  custom_styles_inline: block.settings.custom_styles_inline,
  shopify_attributes: block.shopify_attributes %}

{% schema %}
{
  "name": "DM Before / After",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "image_before",
      "label": "Before image URL",
      "info": "Full URL to the before image. External CDN URLs or Shopify file URLs both work."
    },
    {
      "type": "text",
      "id": "image_after",
      "label": "After image URL",
      "info": "Full URL to the after image. External CDN URLs or Shopify file URLs both work."
    },
    {
      "type": "select",
      "id": "variant",
      "label": "Handle style",
      "info": "Styles the drag handle, chevrons and divider line as one bundle.",
      "options": [
        {
          "label": "Solid (opaque puck)",
          "value": "solid"
        },
        {
          "label": "Bar (slim capsule, no chevrons)",
          "value": "bar"
        },
        {
          "label": "Minimal (chevrons only)",
          "value": "minimal"
        }
      ],
      "default": "solid"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Aspect ratio",
      "options": [
        {
          "label": "Auto (image's natural ratio)",
          "value": "auto"
        },
        {
          "label": "Square (1:1)",
          "value": "square"
        },
        {
          "label": "Portrait (3:4)",
          "value": "portrait"
        },
        {
          "label": "Landscape (4:3)",
          "value": "landscape"
        },
        {
          "label": "Wide (16:9)",
          "value": "wide"
        }
      ],
      "default": "square"
    },
    {
      "type": "select",
      "id": "radius",
      "label": "Radius",
      "options": [
        {
          "label": "None",
          "value": "none"
        },
        {
          "label": "Small",
          "value": "sm"
        },
        {
          "label": "Medium",
          "value": "md"
        },
        {
          "label": "Large",
          "value": "lg"
        },
        {
          "label": "Full (circle, forces 1:1)",
          "value": "full"
        }
      ],
      "default": "md"
    },
    {
      "type": "text",
      "id": "line_color",
      "label": "Line color (paint string)",
      "info": "Empty = theme default. Drives divider line + handle border + chevrons. Accepts var(--dm-...), hex, oklch, or any CSS color."
    },
        {
      "type": "textarea",
      "id": "custom_styles_attrs",
      "label": "Custom styles — data attributes (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    },
    {
      "type": "textarea",
      "id": "custom_styles_inline",
      "label": "Custom styles — inline CSS (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    }
  ],
  "presets": [
    {
      "name": "DM Before / After"
    }
  ]
}
{% endschema %}
