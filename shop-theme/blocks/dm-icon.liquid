{%- comment -%}
  `icon` — thin shim. The markup lives in snippets/dm-atom-icon.liquid,
  shared with the inline emitter so a deep tree renders identically without
  spending a block level. This file owns only what a snippet CAN'T do:
  `content_for` (template-source-only) and the schema block.
{%- endcomment -%}
{% render 'dm-atom-icon',
  name: block.settings.name,
  size: block.settings.size,
  size_sm: block.settings.size_sm,
  color: block.settings.color,
  margin_top: block.settings.margin_top,
  margin_top_sm: block.settings.margin_top_sm,
  custom_styles_attrs: block.settings.custom_styles_attrs,
  custom_styles_inline: block.settings.custom_styles_inline,
  shopify_attributes: block.shopify_attributes %}

{% schema %}
{
  "name": "DM Icon",
  "tag": null,
  "settings": [
    {
      "type": "textarea",
      "id": "name",
      "label": "Icon Name",
      "default": "ph:check-circle"
    },
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "options": [
        {
          "label": "Xs",
          "value": "xs"
        },
        {
          "label": "Sm",
          "value": "sm"
        },
        {
          "label": "Md",
          "value": "md"
        },
        {
          "label": "Lg",
          "value": "lg"
        },
        {
          "label": "Xl",
          "value": "xl"
        }
      ],
      "default": "md"
    },
    {
      "type": "select",
      "id": "size_sm",
      "label": "Size (Mobile)",
      "options": [
        {
          "label": "—",
          "value": ""
        },
        {
          "label": "Xs",
          "value": "xs"
        },
        {
          "label": "Sm",
          "value": "sm"
        },
        {
          "label": "Md",
          "value": "md"
        },
        {
          "label": "Lg",
          "value": "lg"
        },
        {
          "label": "Xl",
          "value": "xl"
        }
      ],
      "default": ""
    },
    {
      "type": "text",
      "id": "color",
      "label": "Color",
      "info": "Any CSS color — e.g. var(--dm-primary), #FF0000, oklch(...). Empty = inherit cascade."
    },
    {
      "type": "text",
      "id": "margin_top",
      "label": "Margin Top"
    },
    {
      "type": "text",
      "id": "margin_top_sm",
      "label": "Margin Top (Mobile)"
    },
        {
      "type": "textarea",
      "id": "custom_styles_attrs",
      "label": "Custom styles — data attributes (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    },
    {
      "type": "textarea",
      "id": "custom_styles_inline",
      "label": "Custom styles — inline CSS (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    }
  ],
  "presets": [
    {
      "name": "DM Icon"
    }
  ]
}
{% endschema %}
