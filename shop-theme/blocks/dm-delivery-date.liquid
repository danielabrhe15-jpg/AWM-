{%- comment -%}
  `delivery-date` — thin shim. The markup lives in snippets/dm-atom-delivery-date.liquid,
  shared with the inline emitter so a deep tree renders identically without
  spending a block level. This file owns only what a snippet CAN'T do:
  `content_for` (template-source-only) and the schema block.
{%- endcomment -%}
{%- capture children -%}
  {% content_for 'blocks' %}
  {{ block.settings.dm_inline_children }}
{%- endcapture -%}
{% render 'dm-atom-delivery-date',
  dispatched_min_days: block.settings.dispatched_min_days,
  dispatched_max_days: block.settings.dispatched_max_days,
  delivered_min_days: block.settings.delivered_min_days,
  delivered_max_days: block.settings.delivered_max_days,
  date_format: block.settings.date_format,
  custom_styles_attrs: block.settings.custom_styles_attrs,
  custom_styles_inline: block.settings.custom_styles_inline,
  shopify_attributes: block.shopify_attributes,
  children: children %}

{% schema %}
{
  "name": "DM Delivery Date",
  "tag": null,
  "settings": [
    {
      "type": "number",
      "id": "dispatched_min_days",
      "label": "Dispatched min (days)",
      "default": 1
    },
    {
      "type": "number",
      "id": "dispatched_max_days",
      "label": "Dispatched max (days)",
      "default": 3
    },
    {
      "type": "number",
      "id": "delivered_min_days",
      "label": "Delivered min (days)",
      "default": 5
    },
    {
      "type": "number",
      "id": "delivered_max_days",
      "label": "Delivered max (days)",
      "default": 7
    },
    {
      "type": "select",
      "id": "date_format",
      "label": "Date format",
      "options": [
        { "label": "Short (5 May)", "value": "short" },
        { "label": "Medium (5 May 2026)", "value": "medium" },
        { "label": "Long (Tue, May 5)", "value": "long" }
      ],
      "default": "short"
    },
        {
      "type": "textarea",
      "id": "custom_styles_attrs",
      "label": "Custom styles — data attributes (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    },
    {
      "type": "textarea",
      "id": "custom_styles_inline",
      "label": "Custom styles — inline CSS (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    },
    {
      "type": "liquid",
      "id": "dm_inline_children",
      "label": "Inlined children (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    }
  ],
  "presets": [
    { "name": "DM Delivery Date" }
  ],
  "blocks": [
    { "type": "@theme" }
  ]
}
{% endschema %}
