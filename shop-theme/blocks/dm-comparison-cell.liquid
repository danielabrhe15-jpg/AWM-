{%- comment -%}
  `comparison-cell` (type `ComparisonCell`) — thin shim. The markup lives in
  snippets/dm-atom-comparison-cell.liquid, shared with the inline emitter so a
  deep tree renders identically without spending a block level. This file owns
  only what a snippet CAN'T do: `content_for` and the schema block.

  `blocks: [{ "type": "@theme" }]` — a cell is a free composition zone (Icon /
  Text / Media / Button / Group / …), so it accepts any DM atom block.
{%- endcomment -%}
{%- capture children -%}
  {% content_for 'blocks' %}
  {{ block.settings.dm_inline_children }}
{%- endcapture -%}
{% render 'dm-atom-comparison-cell',
  align: block.settings.align,
  valign: block.settings.valign,
  bg: block.settings.bg,
  shopify_attributes: block.shopify_attributes,
  children: children %}

{% schema %}
{
  "name": "DM Comparison Cell",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "align",
      "label": "Align",
      "options": [
        { "label": "Start", "value": "start" },
        { "label": "Center", "value": "center" },
        { "label": "End", "value": "end" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "valign",
      "label": "Vertical align",
      "options": [
        { "label": "Top", "value": "top" },
        { "label": "Middle", "value": "middle" },
        { "label": "Bottom", "value": "bottom" }
      ],
      "default": "middle"
    },
    {
      "type": "text",
      "id": "bg",
      "label": "Background",
      "info": "Any CSS color. Empty = transparent (inherits the row / featured-column layer)."
    },
    {
      "type": "liquid",
      "id": "dm_inline_children",
      "label": "Inlined children (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    }
  ],
  "blocks": [
    { "type": "@theme" }
  ]
}
{% endschema %}
