{%- comment -%}
  `divider` — thin shim. The markup lives in snippets/dm-atom-divider.liquid,
  shared with the inline emitter so a deep tree renders identically without
  spending a block level. This file owns only what a snippet CAN'T do:
  `content_for` (template-source-only) and the schema block.
{%- endcomment -%}
{% render 'dm-atom-divider',
  direction: block.settings.direction,
  style: block.settings.style,
  color: block.settings.color,
  spacing: block.settings.spacing,
  width: block.settings.width,
  thickness: block.settings.thickness,
  margin_top: block.settings.margin_top,
  margin_top_sm: block.settings.margin_top_sm,
  custom_styles_attrs: block.settings.custom_styles_attrs,
  custom_styles_inline: block.settings.custom_styles_inline,
  shopify_attributes: block.shopify_attributes %}

{% schema %}
{
  "name": "DM Divider",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "options": [
        {
          "label": "Horizontal",
          "value": "horizontal"
        },
        {
          "label": "Vertical",
          "value": "vertical"
        }
      ],
      "default": "horizontal"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        {
          "label": "Solid",
          "value": "solid"
        },
        {
          "label": "Dashed",
          "value": "dashed"
        },
        {
          "label": "Dotted",
          "value": "dotted"
        }
      ],
      "default": "solid"
    },
    {
      "type": "text",
      "id": "color",
      "label": "Color",
      "info": "Any CSS color — e.g. var(--dm-primary), #FF0000. Empty = inherit theme `--dm-border`."
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Spacing",
      "options": [
        {
          "label": "0",
          "value": "0"
        },
        {
          "label": "1",
          "value": "1"
        },
        {
          "label": "2",
          "value": "2"
        },
        {
          "label": "4",
          "value": "4"
        },
        {
          "label": "6",
          "value": "6"
        },
        {
          "label": "8",
          "value": "8"
        }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        {
          "label": "Full",
          "value": "full"
        },
        {
          "label": "3/4",
          "value": "3/4"
        },
        {
          "label": "1/2",
          "value": "1/2"
        },
        {
          "label": "1/4",
          "value": "1/4"
        }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "thickness",
      "label": "Thickness",
      "options": [
        {
          "label": "Thin",
          "value": "thin"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Thick",
          "value": "thick"
        }
      ],
      "default": "thin"
    },
    {
      "type": "text",
      "id": "margin_top",
      "label": "Margin Top"
    },
    {
      "type": "text",
      "id": "margin_top_sm",
      "label": "Margin Top (Mobile)"
    },
        {
      "type": "textarea",
      "id": "custom_styles_attrs",
      "label": "Custom styles — data attributes (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    },
    {
      "type": "textarea",
      "id": "custom_styles_inline",
      "label": "Custom styles — inline CSS (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    }
  ],
  "presets": [
    {
      "name": "DM Divider"
    }
  ]
}
{% endschema %}
