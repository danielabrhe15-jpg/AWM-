{%- comment -%}
  `accordion-trigger` — thin shim. The markup lives in snippets/dm-atom-accordion-trigger.liquid,
  shared with the inline emitter so a deep tree renders identically without
  spending a block level. This file owns only what a snippet CAN'T do:
  `content_for` (template-source-only) and the schema block.
{%- endcomment -%}
{%- capture children -%}
  {% content_for 'blocks' %}
  {{ block.settings.dm_inline_children }}
{%- endcapture -%}
{% render 'dm-atom-accordion-trigger',
  icon_animation: block.settings.icon_animation,
  shopify_attributes: block.shopify_attributes,
  children: children %}

{% schema %}
{
  "name": "DM Accordion Trigger",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "icon_animation",
      "label": "Icon animation",
      "options": [
        { "label": "Rotate 180° on open", "value": "rotate" },
        { "label": "None", "value": "none" }
      ],
      "default": "rotate"
    },
    {
      "type": "liquid",
      "id": "dm_inline_children",
      "label": "Inlined children (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    }
  ],
  "blocks": [
    { "type": "@theme" }
  ]
}
{% endschema %}
