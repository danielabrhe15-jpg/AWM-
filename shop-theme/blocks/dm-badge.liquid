{%- comment -%}
  `badge` — thin shim. The markup lives in snippets/dm-atom-badge.liquid,
  shared with the inline emitter so a deep tree renders identically without
  spending a block level. This file owns only what a snippet CAN'T do:
  `content_for` (template-source-only) and the schema block.
{%- endcomment -%}
{%- capture children -%}
  {% content_for 'blocks' %}
  {{ block.settings.dm_inline_children }}
{%- endcapture -%}
{% render 'dm-atom-badge',
  variant: block.settings.variant,
  size: block.settings.size,
  bg: block.settings.bg,
  color: block.settings.color,
  radius: block.settings.radius,
  margin_top: block.settings.margin_top,
  margin_top_sm: block.settings.margin_top_sm,
  custom_styles_attrs: block.settings.custom_styles_attrs,
  custom_styles_inline: block.settings.custom_styles_inline,
  shopify_attributes: block.shopify_attributes,
  children: children %}

{% schema %}
{
  "name": "DM Badge",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "variant",
      "label": "Variant",
      "options": [
        {
          "label": "Default",
          "value": "default"
        },
        {
          "label": "Success",
          "value": "success"
        },
        {
          "label": "Warning",
          "value": "warning"
        },
        {
          "label": "Info",
          "value": "info"
        },
        {
          "label": "Destructive",
          "value": "destructive"
        }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "options": [
        {
          "label": "Sm",
          "value": "sm"
        },
        {
          "label": "Md",
          "value": "md"
        },
        {
          "label": "Lg",
          "value": "lg"
        },
        {
          "label": "Xl",
          "value": "xl"
        }
      ],
      "default": "sm"
    },
    {
      "type": "select",
      "id": "radius",
      "label": "Radius",
      "info": "Border-radius scale token. Resolves to the brand-kit's --dm-radius-* values.",
      "options": [
        { "label": "None", "value": "none" },
        { "label": "Xs", "value": "xs" },
        { "label": "Sm", "value": "sm" },
        { "label": "Md", "value": "md" },
        { "label": "Lg", "value": "lg" },
        { "label": "Xl", "value": "xl" }
      ],
      "default": "sm"
    },
    {
      "type": "text",
      "id": "bg",
      "label": "Background",
      "info": "Any CSS color — hex, rgb, oklch, or var(--dm-X). Empty = variant default."
    },
    {
      "type": "text",
      "id": "color",
      "label": "Text color",
      "info": "Any CSS color — hex, rgb, oklch, or var(--dm-X). Empty = variant default."
    },
    {
      "type": "text",
      "id": "margin_top",
      "label": "Margin Top"
    },
    {
      "type": "text",
      "id": "margin_top_sm",
      "label": "Margin Top (Mobile)"
    },
        {
      "type": "textarea",
      "id": "custom_styles_attrs",
      "label": "Custom styles — data attributes (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    },
    {
      "type": "textarea",
      "id": "custom_styles_inline",
      "label": "Custom styles — inline CSS (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    },
    {
      "type": "liquid",
      "id": "dm_inline_children",
      "label": "Inlined children (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    }
  ],
  "presets": [
    {
      "name": "DM Badge"
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    }
  ]
}
{% endschema %}
