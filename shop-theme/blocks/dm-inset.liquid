{%- comment -%}
  `inset` — thin shim. The markup lives in snippets/dm-atom-inset.liquid,
  shared with the inline emitter so a deep tree renders identically without
  spending a block level. This file owns only what a snippet CAN'T do:
  `content_for` (template-source-only) and the schema block.
{%- endcomment -%}
{%- capture children -%}
  {% content_for 'blocks' %}
  {{ block.settings.dm_inline_children }}
{%- endcapture -%}
{% render 'dm-atom-inset',
  side: block.settings.side,
  margin_top: block.settings.margin_top,
  margin_top_sm: block.settings.margin_top_sm,
  custom_styles_attrs: block.settings.custom_styles_attrs,
  custom_styles_inline: block.settings.custom_styles_inline,
  shopify_attributes: block.shopify_attributes,
  children: children %}

{% schema %}
{
  "name": "DM Inset",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "side",
      "label": "Inset side",
      "options": [
        {
          "label": "Top",
          "value": "top"
        },
        {
          "label": "Bottom",
          "value": "bottom"
        },
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Right",
          "value": "right"
        },
        {
          "label": "Horizontal",
          "value": "x"
        },
        {
          "label": "Vertical",
          "value": "y"
        },
        {
          "label": "All sides",
          "value": "all"
        },
        {
          "label": "Full bleed (viewport)",
          "value": "full-bleed"
        },
        {
          "label": "Bleed left (viewport)",
          "value": "bleed-left"
        },
        {
          "label": "Bleed right (viewport)",
          "value": "bleed-right"
        }
      ],
      "default": "top"
    },
    {
      "type": "text",
      "id": "margin_top",
      "label": "Margin Top"
    },
    {
      "type": "text",
      "id": "margin_top_sm",
      "label": "Margin Top (Mobile)"
    },
        {
      "type": "textarea",
      "id": "custom_styles_attrs",
      "label": "Custom styles — data attributes (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    },
    {
      "type": "textarea",
      "id": "custom_styles_inline",
      "label": "Custom styles — inline CSS (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    },
    {
      "type": "liquid",
      "id": "dm_inline_children",
      "label": "Inlined children (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    }
  ],
  "presets": [
    {
      "name": "DM Inset"
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    }
  ]
}
{% endschema %}
