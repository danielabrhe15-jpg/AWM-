{%- comment -%}
  `countdown` — thin shim. The markup lives in snippets/dm-atom-countdown.liquid,
  shared with the inline emitter so a deep tree renders identically without
  spending a block level. This file owns only what a snippet CAN'T do:
  `content_for` (template-source-only) and the schema block.
{%- endcomment -%}
{%- capture children -%}
  {% content_for 'blocks' %}
  {{ block.settings.dm_inline_children }}
{%- endcapture -%}
{% render 'dm-atom-countdown',
  mode: block.settings.mode,
  duration_seconds: block.settings.duration_seconds,
  pad_digits: block.settings.pad_digits,
  format: block.settings.format,
  margin_top: block.settings.margin_top,
  margin_top_sm: block.settings.margin_top_sm,
  custom_styles_attrs: block.settings.custom_styles_attrs,
  custom_styles_inline: block.settings.custom_styles_inline,
  shopify_attributes: block.shopify_attributes,
  children: children %}

{% schema %}
{
  "name": "DM Countdown",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "mode",
      "label": "Mode",
      "options": [
        { "label": "Duration (per-visitor)", "value": "duration" }
      ],
      "default": "duration"
    },
    {
      "type": "number",
      "id": "duration_seconds",
      "label": "Duration (seconds)",
      "default": 3600
    },
    {
      "type": "select",
      "id": "pad_digits",
      "label": "Pad digits",
      "options": [
        { "label": "Two (05)", "value": "two" },
        { "label": "One (5)", "value": "one" }
      ],
      "default": "two"
    },
    {
      "type": "select",
      "id": "format",
      "label": "Format",
      "options": [
        { "label": "HH:MM:SS (default)", "value": "hms" },
        { "label": "MM:SS — short timers", "value": "ms" },
        { "label": "HH:MM — multi-hour, less jitter", "value": "hm" },
        { "label": "Seconds only", "value": "s" },
        { "label": "DD:HH:MM:SS — multi-day", "value": "dhms" }
      ],
      "default": "hms"
    },
    {
      "type": "text",
      "id": "margin_top",
      "label": "Margin Top"
    },
    {
      "type": "text",
      "id": "margin_top_sm",
      "label": "Margin Top (Mobile)"
    },
        {
      "type": "textarea",
      "id": "custom_styles_attrs",
      "label": "Custom styles — data attributes (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    },
    {
      "type": "textarea",
      "id": "custom_styles_inline",
      "label": "Custom styles — inline CSS (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    },
    {
      "type": "liquid",
      "id": "dm_inline_children",
      "label": "Inlined children (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    }
  ],
  "presets": [
    { "name": "DM Countdown" }
  ],
  "blocks": [
    { "type": "@theme" }
  ]
}
{% endschema %}
