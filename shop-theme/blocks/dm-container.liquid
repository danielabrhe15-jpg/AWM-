{%- comment -%}
  `container` — thin shim. The markup lives in snippets/dm-atom-container.liquid,
  shared with the inline emitter so a deep tree renders identically without
  spending a block level. This file owns only what a snippet CAN'T do:
  `content_for` (template-source-only) and the schema block.
{%- endcomment -%}
{%- capture children -%}
  {% content_for 'blocks' %}
  {{ block.settings.dm_inline_children }}
{%- endcapture -%}
{% render 'dm-atom-container',
  max_width: block.settings.max_width,
  max_width_sm: block.settings.max_width_sm,
  margin_top: block.settings.margin_top,
  margin_top_sm: block.settings.margin_top_sm,
  custom_styles_attrs: block.settings.custom_styles_attrs,
  custom_styles_inline: block.settings.custom_styles_inline,
  shopify_attributes: block.shopify_attributes,
  children: children %}

{% schema %}
{
  "name": "DM Container",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "max_width",
      "label": "Max Width",
      "options": [
        {
          "label": "None",
          "value": "none"
        },
        {
          "label": "Xs",
          "value": "xs"
        },
        {
          "label": "Sm",
          "value": "sm"
        },
        {
          "label": "Md",
          "value": "md"
        },
        {
          "label": "Lg",
          "value": "lg"
        },
        {
          "label": "Xl",
          "value": "xl"
        },
        {
          "label": "2xl",
          "value": "2xl"
        }
      ],
      "default": "lg"
    },
    {
      "type": "select",
      "id": "max_width_sm",
      "label": "Max Width (Mobile)",
      "options": [
        {
          "label": "—",
          "value": ""
        },
        {
          "label": "None",
          "value": "none"
        },
        {
          "label": "Xs",
          "value": "xs"
        },
        {
          "label": "Sm",
          "value": "sm"
        },
        {
          "label": "Md",
          "value": "md"
        },
        {
          "label": "Lg",
          "value": "lg"
        },
        {
          "label": "Xl",
          "value": "xl"
        },
        {
          "label": "2xl",
          "value": "2xl"
        }
      ],
      "default": ""
    },
    {
      "type": "text",
      "id": "margin_top",
      "label": "Margin Top"
    },
    {
      "type": "text",
      "id": "margin_top_sm",
      "label": "Margin Top (Mobile)"
    },
        {
      "type": "textarea",
      "id": "custom_styles_attrs",
      "label": "Custom styles — data attributes (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    },
    {
      "type": "textarea",
      "id": "custom_styles_inline",
      "label": "Custom styles — inline CSS (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    },
    {
      "type": "liquid",
      "id": "dm_inline_children",
      "label": "Inlined children (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    }
  ],
  "presets": [
    {
      "name": "DM Container"
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    },
    { "type": "@app" }
  ]
}
{% endschema %}
