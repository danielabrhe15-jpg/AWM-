{%- comment -%}
  `image` — thin shim. The markup lives in snippets/dm-atom-image.liquid,
  shared with the inline emitter so a deep tree renders identically without
  spending a block level. This file owns only what a snippet CAN'T do:
  `content_for` (template-source-only) and the schema block.
{%- endcomment -%}
{% render 'dm-atom-image',
  src: block.settings.src,
  alt: block.settings.alt,
  width: block.settings.width,
  width_sm: block.settings.width_sm,
  aspect_ratio: block.settings.aspect_ratio,
  aspect_ratio_sm: block.settings.aspect_ratio_sm,
  object_fit: block.settings.object_fit,
  object_position: block.settings.object_position,
  radius: block.settings.radius,
  custom_styles_attrs: block.settings.custom_styles_attrs,
  custom_styles_inline: block.settings.custom_styles_inline,
  shopify_attributes: block.shopify_attributes %}

{% schema %}
{
  "name": "DM Image",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "src",
      "label": "Image URL",
      "default": "https://placehold.co/800x400/e2e8f0/64748b?text=Image"
    },
    {
      "type": "text",
      "id": "alt",
      "label": "Alt Text",
      "default": "Placeholder image"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        {
          "label": "Full",
          "value": "full"
        },
        {
          "label": "Auto",
          "value": "auto"
        }
      ],
      "default": "full"
    },
    {
      "type": "select",
