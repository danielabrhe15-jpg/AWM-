          "value": "16/9"
        },
        {
          "label": "2/1",
          "value": "2/1"
        },
        {
          "label": "3/4",
          "value": "3/4"
        }
      ],
      "default": "auto"
    },
    {
      "type": "select",
      "id": "aspect_ratio_sm",
      "label": "Aspect Ratio (Mobile)",
      "options": [
        {
          "label": "—",
          "value": ""
        },
        {
          "label": "Auto",
