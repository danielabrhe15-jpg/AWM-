        },
        {
          "label": "4/3",
          "value": "4/3"
        },
        {
          "label": "3/2",
          "value": "3/2"
        },
        {
          "label": "16/9",
          "value": "16/9"
        },
        {
          "label": "2/1",
          "value": "2/1"
        },
        {
          "label": "3/4",
          "value": "3/4"
        }
      ],
      "default": ""
    },
    {
      "type": "select",
      "id": "object_fit",
      "label": "Fit",
      "options": [
        {
          "label": "Cover",
          "value": "cover"
        },
        {
