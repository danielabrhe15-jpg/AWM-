{%- comment -%}
  `bundle-units` — thin shim. The markup lives in snippets/dm-atom-bundle-units.liquid,
  shared with the inline emitter so a deep tree renders identically without
  spending a block level. This file owns only what a snippet CAN'T do:
  `content_for` (template-source-only) and the schema block.
{%- endcomment -%}
{% render 'dm-atom-bundle-units',
  unit_count: block.settings.unit_count,
  buy_count: block.settings.buy_count,
  bar_id: block.settings.bar_id,
  show_thumbnail: block.settings.show_thumbnail,
  show_unit_index: block.settings.show_unit_index,
  size: block.settings.size,
  display1: block.settings.display1,
  display2: block.settings.display2,
  display3: block.settings.display3,
  gap: block.settings.gap,
  gap_sm: block.settings.gap_sm,
  margin_top: block.settings.margin_top,
  margin_top_sm: block.settings.margin_top_sm,
  custom_styles_attrs: block.settings.custom_styles_attrs,
  custom_styles_inline: block.settings.custom_styles_inline,
  shopify_attributes: block.shopify_attributes %}

{% schema %}
{
  "name": "DM Bundle Units",
  "tag": null,
  "settings": [
    {
      "type": "number",
      "id": "unit_count",
      "label": "Unit count (auto)",
      "info": "Baked by DropMagic from the tier. Do not edit manually."
    },
    {
      "type": "number",
      "id": "buy_count",
      "label": "Buy count (auto)",
      "info": "bxgy buy/get split — baked by DropMagic. Do not edit manually."
    },
    {
      "type": "text",
      "id": "bar_id",
      "label": "Bar id (auto)",
      "info": "Baked by DropMagic. Do not edit manually."
    },
    {
      "type": "select",
      "id": "show_thumbnail",
      "label": "Thumbnail",
      "options": [
        { "label": "Show", "value": "true" },
        { "label": "Hide", "value": "false" }
      ],
      "default": "true"
    },
    {
      "type": "select",
      "id": "show_unit_index",
      "label": "Unit numbers",
      "options": [
        { "label": "Show", "value": "true" },
        { "label": "Hide", "value": "false" }
      ],
      "default": "false"
    },
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "options": [
        { "label": "Small", "value": "sm" },
        { "label": "Medium", "value": "md" },
        { "label": "Large", "value": "lg" }
      ],
      "default": "sm"
    },
    {
      "type": "select",
      "id": "display1",
      "label": "Option 1 style",
      "options": [
        { "label": "Dropdown", "value": "dropdown" },
        { "label": "Text buttons", "value": "text-button" },
        { "label": "Color swatches", "value": "color-swatch" },
        { "label": "Color dropdown", "value": "color-dropdown" },
        { "label": "Image swatches", "value": "image-swatch" },
        { "label": "Image dropdown", "value": "image-dropdown" }
      ],
      "default": "dropdown"
    },
    {
      "type": "select",
      "id": "display2",
      "label": "Option 2 style",
      "options": [
        { "label": "Dropdown", "value": "dropdown" },
        { "label": "Text buttons", "value": "text-button" },
        { "label": "Color swatches", "value": "color-swatch" },
        { "label": "Color dropdown", "value": "color-dropdown" },
        { "label": "Image swatches", "value": "image-swatch" },
        { "label": "Image dropdown", "value": "image-dropdown" }
      ],
      "default": "dropdown"
    },
    {
      "type": "select",
      "id": "display3",
      "label": "Option 3 style",
      "options": [
        { "label": "Dropdown", "value": "dropdown" },
        { "label": "Text buttons", "value": "text-button" },
        { "label": "Color swatches", "value": "color-swatch" },
        { "label": "Color dropdown", "value": "color-dropdown" },
        { "label": "Image swatches", "value": "image-swatch" },
        { "label": "Image dropdown", "value": "image-dropdown" }
      ],
      "default": "dropdown"
    },
    { "type": "text", "id": "gap", "label": "Gap", "default": "2" },
    { "type": "text", "id": "gap_sm", "label": "Gap (Mobile)" },
    { "type": "text", "id": "margin_top", "label": "Margin Top" },
    { "type": "text", "id": "margin_top_sm", "label": "Margin Top (Mobile)" },
    {
      "type": "textarea",
      "id": "custom_styles_attrs",
      "label": "Custom styles — data attributes (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    },
    {
      "type": "textarea",
      "id": "custom_styles_inline",
      "label": "Custom styles — inline CSS (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    }
  ],
  "presets": [
    { "name": "DM Bundle Units" }
  ]
}
{% endschema %}
