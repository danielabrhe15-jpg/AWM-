{%- comment -%}
  `avatar` — thin shim. The markup lives in snippets/dm-atom-avatar.liquid,
  shared with the inline emitter so a deep tree renders identically without
  spending a block level. This file owns only what a snippet CAN'T do:
  `content_for` (template-source-only) and the schema block.
{%- endcomment -%}
{% render 'dm-atom-avatar',
  src: block.settings.src,
  alt: block.settings.alt,
  size: block.settings.size,
  shape: block.settings.shape,
  object_position: block.settings.object_position,
  ring_width: block.settings.ring_width,
  ring_color: block.settings.ring_color,
  shadow: block.settings.shadow,
  margin_top: block.settings.margin_top,
  margin_top_sm: block.settings.margin_top_sm,
  custom_styles_attrs: block.settings.custom_styles_attrs,
  custom_styles_inline: block.settings.custom_styles_inline,
  shopify_attributes: block.shopify_attributes %}

{% schema %}
{
  "name": "DM Avatar",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "src",
      "label": "Source URL",
      "default": "https://i.pravatar.cc/300?img=12"
    },
    {
      "type": "text",
      "id": "alt",
      "label": "Alt Text",
      "default": "auto"
    },
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "options": [
        { "label": "XS (24px)", "value": "xs" },
        { "label": "SM (32px)", "value": "sm" },
        { "label": "MD (48px)", "value": "md" },
        { "label": "LG (64px)", "value": "lg" },
        { "label": "XL (96px)", "value": "xl" }
      ],
      "default": "md"
    },
    {
      "type": "select",
      "id": "shape",
      "label": "Shape",
      "options": [
        { "label": "Circle", "value": "circle" },
        { "label": "Rounded", "value": "rounded" },
        { "label": "Square", "value": "square" }
      ],
      "default": "circle"
    },
    {
      "type": "select",
      "id": "object_position",
      "label": "Position",
      "options": [
        { "label": "Center", "value": "center" },
        { "label": "Top", "value": "top" },
        { "label": "Bottom", "value": "bottom" },
        { "label": "Left", "value": "left" },
        { "label": "Right", "value": "right" }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "ring_width",
      "label": "Ring width",
      "info": "e.g. 2px. Empty = no ring."
    },
    {
      "type": "text",
      "id": "ring_color",
      "label": "Ring color",
      "info": "Empty = section background. Accepts var(--dm-...), hex, oklch."
    },
    {
      "type": "text",
      "id": "shadow",
      "label": "Shadow"
    },
    {
      "type": "text",
      "id": "margin_top",
      "label": "Margin Top"
    },
    {
      "type": "text",
      "id": "margin_top_sm",
      "label": "Margin Top (Mobile)"
    },
        {
      "type": "textarea",
      "id": "custom_styles_attrs",
      "label": "Custom styles — data attributes (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    },
    {
      "type": "textarea",
      "id": "custom_styles_inline",
      "label": "Custom styles — inline CSS (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    }
  ],
  "presets": [
    {
      "name": "DM Avatar"
    }
  ]
}
{% endschema %}
