{%- comment -%}
  `link` — thin shim. The markup lives in snippets/dm-atom-link.liquid,
  shared with the inline emitter so a deep tree renders identically without
  spending a block level. This file owns only what a snippet CAN'T do:
  `content_for` (template-source-only) and the schema block.
{%- endcomment -%}
{%- capture children -%}
  {% content_for 'blocks' %}
  {{ block.settings.dm_inline_children }}
{%- endcapture -%}
{% render 'dm-atom-link',
  href: block.settings.href,
  target: block.settings.target,
  bind: block.settings.bind,
  margin_top: block.settings.margin_top,
  margin_top_sm: block.settings.margin_top_sm,
  custom_styles_attrs: block.settings.custom_styles_attrs,
  custom_styles_inline: block.settings.custom_styles_inline,
  shopify_attributes: block.shopify_attributes,
  children: children %}

{% schema %}
{
  "name": "DM Link",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "href",
      "label": "Link",
      "info": "DropMagic smart-link (scheme-encoded). Authored in the builder; do not hand-edit."
    },
    {
      "type": "select",
      "id": "target",
      "label": "Target",
      "options": [
        {
          "label": "_self",
          "value": "_self"
        },
        {
          "label": "_blank",
          "value": "_blank"
        }
      ],
      "default": "_self"
    },
    {
      "type": "select",
      "id": "bind",
      "label": "Dynamic link",
      "options": [
        {
          "value": "",
          "label": "None (static href)"
        },
        {
          "value": "product.url",
          "label": "Product URL"
        }
      ],
      "default": ""
    },
    {
      "type": "text",
      "id": "margin_top",
      "label": "Margin Top"
    },
    {
      "type": "text",
      "id": "margin_top_sm",
      "label": "Margin Top (Mobile)"
    },
    {
      "type": "textarea",
      "id": "custom_styles_attrs",
      "label": "Custom styles — data attributes (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    },
    {
      "type": "textarea",
      "id": "custom_styles_inline",
      "label": "Custom styles — inline CSS (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    },
    {
      "type": "liquid",
      "id": "dm_inline_children",
      "label": "Inlined children (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    }
  ],
  "presets": [
    {
      "name": "DM Link"
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    }
  ]
}
{% endschema %}
