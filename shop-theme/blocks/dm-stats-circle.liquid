{%- comment -%}
  `stats-circle` — thin shim. The markup lives in snippets/dm-atom-stats-circle.liquid,
  shared with the inline emitter so a deep tree renders identically without
  spending a block level. This file owns only what a snippet CAN'T do:
  `content_for` (template-source-only) and the schema block.
{%- endcomment -%}
{% render 'dm-atom-stats-circle',
  percentage: block.settings.percentage,
  size: block.settings.size,
  size_sm: block.settings.size_sm,
  stroke_width: block.settings.stroke_width,
  text_type: block.settings.text_type,
  animated: block.settings.animated,
  track_color: block.settings.track_color,
  fill_color: block.settings.fill_color,
  label_color: block.settings.label_color,
  custom_styles_attrs: block.settings.custom_styles_attrs,
  custom_styles_inline: block.settings.custom_styles_inline,
  shopify_attributes: block.shopify_attributes %}

{% schema %}
{
  "name": "DM Stats Circle",
  "tag": null,
  "settings": [
    {
      "type": "number",
      "id": "percentage",
      "label": "Percentage (0–100)",
      "default": 75
    },
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "options": [
        {
          "label": "sm (40px)",
          "value": "sm"
        },
        {
          "label": "md (64px)",
          "value": "md"
        },
        {
          "label": "lg (96px)",
          "value": "lg"
        },
        {
          "label": "xl (128px)",
          "value": "xl"
        }
      ],
      "default": "md"
    },
    {
      "type": "select",
      "id": "size_sm",
      "label": "Size (Mobile)",
      "options": [
        {
          "label": "—",
          "value": ""
        },
        {
          "label": "sm (40px)",
          "value": "sm"
        },
        {
          "label": "md (64px)",
          "value": "md"
        },
        {
          "label": "lg (96px)",
          "value": "lg"
        },
        {
          "label": "xl (128px)",
          "value": "xl"
        }
      ],
      "default": ""
    },
    {
      "type": "select",
      "id": "stroke_width",
      "label": "Stroke width",
      "options": [
        {
          "label": "Thin",
          "value": "thin"
        },
        {
          "label": "Medium",
          "value": "md"
        },
        {
          "label": "Thick",
          "value": "thick"
        }
      ],
      "default": "md"
    },
    {
      "type": "select",
      "id": "text_type",
      "label": "Center label",
      "options": [
        {
          "label": "None",
          "value": "none"
        },
        {
          "label": "Percentage (75%)",
          "value": "percentage"
        },
        {
          "label": "Value (75)",
          "value": "value"
        }
      ],
      "default": "percentage"
    },
    {
      "type": "select",
      "id": "animated",
      "label": "Animation",
      "options": [
        {
          "label": "On appear",
          "value": "on-appear"
        },
        {
          "label": "None",
          "value": "none"
        }
      ],
      "default": "on-appear"
    },
    {
      "type": "text",
      "id": "track_color",
      "label": "Track color (paint string)",
      "info": "Empty = theme default. Accepts var(--dm-...), hex, oklch, or any CSS gradient."
    },
    {
      "type": "text",
      "id": "fill_color",
      "label": "Fill color (paint string)",
      "info": "Empty = theme default. Drives the ring and (unless Label color is set) the center label."
    },
    {
      "type": "text",
      "id": "label_color",
      "label": "Label color (paint string)",
      "info": "Empty = inherits the fill color. Set a solid color for the center number — for legibility, or when the fill is a gradient."
    },
        {
      "type": "textarea",
      "id": "custom_styles_attrs",
      "label": "Custom styles — data attributes (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    },
    {
      "type": "textarea",
      "id": "custom_styles_inline",
      "label": "Custom styles — inline CSS (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    }
  ],
  "presets": [
    {
      "name": "DM Stats Circle"
    }
  ]
}
{% endschema %}
