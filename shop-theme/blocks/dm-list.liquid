{%- comment -%}
  `list` — thin shim. The markup lives in snippets/dm-atom-list.liquid,
  shared with the inline emitter so a deep tree renders identically without
  spending a block level. This file owns only what a snippet CAN'T do:
  `content_for` (template-source-only) and the schema block.
{%- endcomment -%}
{%- capture children -%}
  {% content_for 'blocks' %}
  {{ block.settings.dm_inline_children }}
{%- endcapture -%}
{%- capture arrow_html -%}
  {% content_for 'block', type: 'dm-button', id: 'arrow' %}
  {{ block.settings.dm_inline_arrow_html }}
{%- endcapture -%}
{% render 'dm-atom-list',
  desktop_layout: block.settings.desktop_layout,
  mobile_layout: block.settings.mobile_layout,
  columns: block.settings.columns,
  columns_sm: block.settings.columns_sm,
  gap: block.settings.gap,
  gap_sm: block.settings.gap_sm,
  slides_per_view: block.settings.slides_per_view,
  slides_per_view_sm: block.settings.slides_per_view_sm,
  width: block.settings.width,
  speed: block.settings.speed,
  loop: block.settings.loop,
  autoplay: block.settings.autoplay,
  autoplay_delay: block.settings.autoplay_delay,
  pause_on_hover: block.settings.pause_on_hover,
  bind: block.settings.bind,
  media_filled: block.settings.media_filled,
  arrows_show: block.settings.arrows_show,
  arrows_position: block.settings.arrows_position,
  dots_show: block.settings.dots_show,
  dots_style: block.settings.dots_style,
  dots_position: block.settings.dots_position,
  dots_position_sm: block.settings.dots_position_sm,
  margin_top: block.settings.margin_top,
  margin_top_sm: block.settings.margin_top_sm,
  arrows_gap: block.settings.arrows_gap,
  arrows_gap_sm: block.settings.arrows_gap_sm,
  arrows_show_sm: block.settings.arrows_show_sm,
  arrows_position_sm: block.settings.arrows_position_sm,
  dots_size: block.settings.dots_size,
  children_max_width: block.settings.children_max_width,
  children_max_width_sm: block.settings.children_max_width_sm,
  dots_size_sm: block.settings.dots_size_sm,
  dots_show_sm: block.settings.dots_show_sm,
  thumbs_show: block.settings.thumbs_show,
  thumbs_show_sm: block.settings.thumbs_show_sm,
  thumbs_position: block.settings.thumbs_position,
  thumbs_position_sm: block.settings.thumbs_position_sm,
  thumbs_size: block.settings.thumbs_size,
  thumbs_size_sm: block.settings.thumbs_size_sm,
  direction: block.settings.direction,
  direction_sm: block.settings.direction_sm,
  carousel_style: block.settings.carousel_style,
  stacked_variant: block.settings.stacked_variant,
  custom_styles_attrs: block.settings.custom_styles_attrs,
  custom_styles_inline: block.settings.custom_styles_inline,
  shopify_attributes: block.shopify_attributes,
  children: children,
  arrow_html: arrow_html %}

