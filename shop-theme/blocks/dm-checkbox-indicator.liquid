{%- comment -%}
  `checkbox-indicator` — thin shim. The markup lives in snippets/dm-atom-checkbox-indicator.liquid,
  shared with the inline emitter so a deep tree renders identically without
  spending a block level. This file owns only what a snippet CAN'T do:
  `content_for` (template-source-only) and the schema block.
{%- endcomment -%}
{% render 'dm-atom-checkbox-indicator',
  size: block.settings.size,
  color: block.settings.color,
  check_color: block.settings.check_color,
  border_color: block.settings.border_color,
  border_width: block.settings.border_width,
  radius: block.settings.radius,
  custom_styles_attrs: block.settings.custom_styles_attrs,
  custom_styles_inline: block.settings.custom_styles_inline,
  shopify_attributes: block.shopify_attributes %}

{% schema %}
{
  "name": "DM Checkbox Indicator",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "options": [
        { "label": "Xs", "value": "xs" },
        { "label": "Sm", "value": "sm" },
        { "label": "Md", "value": "md" },
        { "label": "Lg", "value": "lg" },
        { "label": "Xl", "value": "xl" }
      ],
      "default": "md"
    },
    { "type": "text", "id": "color", "label": "Checked fill", "default": "var(--dm-primary)" },
    { "type": "text", "id": "check_color", "label": "Check color", "default": "var(--dm-primary-foreground)" },
    { "type": "text", "id": "border_color", "label": "Border color", "default": "var(--dm-border)" },
    { "type": "text", "id": "border_width", "label": "Border width", "default": "2px" },
    { "type": "text", "id": "radius", "label": "Radius", "default": "var(--dm-radius-sm)" },
    {
      "type": "textarea",
      "id": "custom_styles_attrs",
      "label": "Custom styles — data attributes (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    },
    {
      "type": "textarea",
      "id": "custom_styles_inline",
      "label": "Custom styles — inline CSS (auto)",
      "info": "Auto-generated by DropMagic at publish time. Do not edit manually."
    }
  ],
  "presets": [
    { "name": "DM Checkbox Indicator" }
  ]
}
{% endschema %}
