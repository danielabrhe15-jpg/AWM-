{%- comment -%}
  Generic DropMagic section. Used by the published header-group /
  footer-group JSONs as the type for every top-level Section atom that
  comes from `stores.header_tree` / `stores.footer_tree`. The merchant's
  Section atom IS the section here; its child atoms come through as blocks.

  The section markup lives in the shared snippet `dm-section-render` (also
  used by blocks/dm-section.liquid for body sections) so the two can't
  drift. This file passes `section.settings` + `section.id` (the sticky
  unwrap needs the wrapper id) and owns only the {% schema %} below
  (Shopify can't share schema across section + block files).

  No CSS / runtime-script imports — those live in `dm-page.liquid`, which is
  rendered by every page template that uses DropMagic. Section groups
  inherit the styles loaded in the body via the page template (modern
  browsers apply CSS regardless of declaration order in the document).
{%- endcomment -%}
{%- capture children -%}
  {% content_for 'blocks' %}
{%- endcapture -%}
{% render 'dm-section-render',
  s: section.settings,
  children: children,
  sticky_wrapper_id: section.id %}

{% schema %}
{
  "name": "DM Section",
  "tag": "section",
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "settings": [
    {
      "type": "select",
      "id": "combination",
      "label": "Color Scheme",
      "options": [
        { "label": "White", "value": "white" },
        { "label": "Light", "value": "light" },
        { "label": "Neutral", "value": "neutral" },
        { "label": "Tinted", "value": "tinted" },
        { "label": "Tinted secondary", "value": "tinted-secondary" },
        { "label": "Vibrant", "value": "vibrant" },
        { "label": "Dark", "value": "dark" },
        { "label": "Gradient", "value": "gradient" }
      ],
      "default": "white"
    },
    {
      "type": "select",
      "id": "sticky",
      "label": "Sticky",
      "options": [
        { "value": "relative", "label": "Off" },
        { "value": "sticky", "label": "Sticky" },
        { "value": "sticky-scroll", "label": "Sticky on scroll" }
      ],
      "default": "relative"
    },
    { "type": "text", "id": "padding_top", "label": "Padding Top", "default": "16" },
    { "type": "text", "id": "padding_top_sm", "label": "Padding Top (Mobile)" },
