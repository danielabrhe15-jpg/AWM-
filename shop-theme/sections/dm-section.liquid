        { "label": "Zig zag line", "value": "zig-zag-line" },
        { "label": "Rounded arc", "value": "rounded-arc" },
        { "label": "Simple slope left", "value": "simple-slope-left" },
        { "label": "Simple slope right", "value": "simple-slope-right" },
