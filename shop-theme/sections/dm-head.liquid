{% schema %}
{
  "name": "DM Head",
  "tag": "div",
  "settings": [
    {
      "type": "product",
      "id": "selected_product",
      "label": "Product",
      "info": "Set by Dropmagic at publish time on a page that is not a product template, so the storefront runtime has the page's product. Left empty on a product template, which supplies its own."
    }
  ],
  "presets": [{ "name": "DM Head" }]
}
{% endschema %}
