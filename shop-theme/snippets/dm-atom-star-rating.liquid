{%- comment -%}
  Shared markup for the `star-rating` atom — the single source of truth for
  what this atom renders. Two callers, and they must not drift:
    - blocks/dm-star-rating.liquid  — as a Shopify theme block (shallow)
    - the inline emitter        — as {% render %} inside a parent's
                                  dm_inline setting, when nesting would
                                  otherwise blow Shopify's depth cap of 8

  Params are flat (not a settings object) because Liquid has no object
  literal, so the inline emitter can only pass key: value pairs.
  Slot content arrives PRE-RENDERED as string params (children, …): a
  snippet can never run `content_for`, so the caller captures it.

  No defaults here, deliberately. A {% schema %} `default` is an EDITOR
  seed — it populates the JSON when a merchant adds a block — NOT a
  render-time fallback. Our templates are machine-generated, so a setting
  the emitter omits (`omitValue`) is simply absent and reads blank. Both
  callers take their values from that same emitter map, so re-declaring
  defaults here would invent attributes that never render today.
{%- endcomment -%}
{%- comment -%}
  StarRating atom — fixed 5-star row with half-step partial fills. Pure
  display, no JS. Mirrors `star-rating/render.tsx`: each `.dm-star` stacks
  an empty star SVG under a filled one that's clipped via
  `clip-path: inset(...)`. Rating rounds to the nearest 0.5 (ecom
  convention — true partial fills read as broken). Styling lives in
  dm-theme.css under `dm-star-rating`.
{%- endcomment -%}
{%- assign rating = rating | default: 0 | times: 2.0 | round | divided_by: 2.0 -%}
{%- capture star_style -%}
  {%- if color != blank -%}--dm-star-rating-color: {{ color }};{%- endif -%}
  {%- if empty_color != blank -%}--dm-star-rating-empty-color: {{ empty_color }};{%- endif -%}
{%- endcapture -%}
{%- capture all_inline -%}{{ star_style | strip }}{{ custom_styles_inline }}{%- endcapture -%}
<dm-star-rating
  data-atom-type="star-rating"
  {% if size != blank %}data-star-rating-size="{{ size }}"{% endif %}
  {% if size_sm != blank %}data-star-rating-size-sm="{{ size_sm }}"{% endif %}
  {{ custom_styles_attrs }}
  {% if all_inline != blank %}style="{{ all_inline }}"{% endif %}
  {% if margin_top != blank and margin_top != '0' %}data-mt="{{ margin_top }}"{% endif %}
  {% if margin_top_sm != blank and margin_top_sm != '0' %}data-mt-sm="{{ margin_top_sm }}"{% endif %}
  {{ shopify_attributes }}
>
  {%- for i in (0..4) -%}
    {%- assign fill = rating | minus: i -%}
    {%- if fill < 0 -%}{%- assign fill = 0 -%}{%- endif -%}
    {%- if fill > 1 -%}{%- assign fill = 1 -%}{%- endif -%}
    {%- assign clip_right = 1.0 | minus: fill | times: 100 -%}
    <span class="dm-star">
      <svg class="dm-star-empty" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 17.27 5.82 21l1.64-7.03L2 9.24l7.19-.61L12 2l2.81 6.63 7.19.61-5.46 4.73L18.18 21z" fill="currentColor"></path></svg>
      <svg class="dm-star-filled" viewBox="0 0 24 24" aria-hidden="true" style="clip-path: inset(0 {{ clip_right }}% 0 0)"><path d="M12 17.27 5.82 21l1.64-7.03L2 9.24l7.19-.61L12 2l2.81 6.63 7.19.61-5.46 4.73L18.18 21z" fill="currentColor"></path></svg>
    </span>
  {%- endfor -%}
</dm-star-rating>
