{%- comment -%}
  Shared markup for the `logo` atom — the single source of truth for
  what this atom renders. Two callers, and they must not drift:
    - blocks/dm-logo.liquid  — as a Shopify theme block (shallow)
    - the inline emitter        — as {% render %} inside a parent's
                                  dm_inline setting, when nesting would
                                  otherwise blow Shopify's depth cap of 8

  Params are flat (not a settings object) because Liquid has no object
  literal, so the inline emitter can only pass key: value pairs.
  Slot content arrives PRE-RENDERED as string params (children, …): a
  snippet can never run `content_for`, so the caller captures it.

  No defaults here, deliberately. A {% schema %} `default` is an EDITOR
  seed — it populates the JSON when a merchant adds a block — NOT a
  render-time fallback. Our templates are machine-generated, so a setting
  the emitter omits (`omitValue`) is simply absent and reads blank. Both
  callers take their values from that same emitter map, so re-declaring
  defaults here would invent attributes that never render today.
{%- endcomment -%}
{%- assign logo_height = height | default: 40 -%}
{%- comment -%}
  Accessible name. No store-name param is plumbed through this call chain
  (dm-logo.liquid only forwards src/height/custom-styles), so this reads
  Shopify's own `shop.name` global — every template has it, no new plumbing
  needed. Mirrors render.tsx's `${store.name} logo` / "Logo" fallback.
{%- endcomment -%}
{%- if shop.name != blank -%}
  {%- assign logo_alt = shop.name | append: ' logo' -%}
{%- else -%}
  {%- assign logo_alt = 'Logo' -%}
{%- endif -%}
{%- capture style -%}
  --dm-logo-height: {{ logo_height }}px;
{%- endcapture -%}
{%- capture all_inline -%}{{ style | strip }}{{ custom_styles_inline }}{%- endcapture -%}

{%- comment -%}
  The Logo is not clickable on its own — wrap it in a DM Link (smart-link
  `home`) to make it a header home link. No per-atom link setting.
{%- endcomment -%}
<dm-logo
  data-atom-type="logo"
  {{ custom_styles_attrs }}
  {% if all_inline != blank %}style="{{ all_inline }}"{% endif %}
  {{ shopify_attributes }}
>
  {%- comment -%}
    A generated logo publishes as inline MARKUP (the icon-atom pattern:
    same setting, `contains '<svg'` branch) so its `var(--dm-<role>, hex)`
    fills resolve against the live kit tokens on the storefront. Uploaded /
    legacy logos stay a URL → <img>.
  {%- endcomment -%}
  {% if src contains '<svg' %}
    <span data-logo-inline role="img" aria-label="{{ logo_alt }}">{{ src }}</span>
  {% elsif src != blank %}
    <img src="{{ src }}" alt="{{ logo_alt }}" height="{{ logo_height }}" draggable="false" />
  {% endif %}
</dm-logo>
