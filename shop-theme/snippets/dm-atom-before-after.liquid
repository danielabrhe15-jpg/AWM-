{%- comment -%}
  Shared markup for the `before-after` atom — the single source of truth for
  what this atom renders. Two callers, and they must not drift:
    - blocks/dm-before-after.liquid  — as a Shopify theme block (shallow)
    - the inline emitter        — as {% render %} inside a parent's
                                  dm_inline setting, when nesting would
                                  otherwise blow Shopify's depth cap of 8

  Params are flat (not a settings object) because Liquid has no object
  literal, so the inline emitter can only pass key: value pairs.
  Slot content arrives PRE-RENDERED as string params (children, …): a
  snippet can never run `content_for`, so the caller captures it.

  No defaults here, deliberately. A {% schema %} `default` is an EDITOR
  seed — it populates the JSON when a merchant adds a block — NOT a
  render-time fallback. Our templates are machine-generated, so a setting
  the emitter omits (`omitValue`) is simply absent and reads blank. Both
  callers take their values from that same emitter map, so re-declaring
  defaults here would invent attributes that never render today.
{%- endcomment -%}
{%- capture style -%}
  {%- if line_color != blank %}--dm-before-after-line: {{ line_color }};{% endif -%}
{%- endcapture -%}
{%- capture all_inline -%}{{ style | strip }}{{ custom_styles_inline }}{%- endcapture -%}

<dm-before-after
  data-atom-type="before-after"
  {% if variant != blank and variant != 'solid' %}data-ba-variant="{{ variant }}"{% endif %}
  {% if aspect_ratio != blank %}data-ba-aspect-ratio="{{ aspect_ratio }}"{% endif %}
  {% if radius != blank %}data-before-after-radius="{{ radius }}"{% endif %}
  {{ custom_styles_attrs }}
  {% if all_inline != blank %}style="{{ all_inline }}"{% endif %}
  {{ shopify_attributes }}
>
  <div data-ba-frame>
    {% if image_before != blank %}
      <img data-ba-image-before src="{{ image_before }}" alt="" draggable="false" />
    {% endif %}
    {% if image_after != blank %}
      <img data-ba-image-after src="{{ image_after }}" alt="" draggable="false" />
    {% endif %}
    <div data-ba-line aria-hidden="true"></div>
    <button
      data-ba-handle
      type="button"
      aria-label="Drag to compare"
      role="slider"
      aria-valuemin="0"
      aria-valuemax="100"
    >
      <svg viewBox="0 0 16 16" data-ba-chevron-left aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M10 4L6 8l4 4" />
      </svg>
      <svg viewBox="0 0 16 16" data-ba-chevron-right aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 4l4 4-4 4" />
      </svg>
    </button>
  </div>
</dm-before-after>
