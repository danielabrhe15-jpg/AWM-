{%- if mask_body != blank -%}
  {%- assign mask_transform = '' -%}
  {%- if mask_position == 'top' -%}
    {%- if mask_directional -%}{%- assign mask_flip = 'scaleY(-1) scaleX(-1)' -%}
    {%- else -%}{%- assign mask_flip = 'scaleY(-1)' -%}{%- endif -%}
    {%- if mask_rotate -%}{%- capture mask_transform -%}{{ mask_flip }} rotate(180deg){%- endcapture -%}
    {%- else -%}{%- assign mask_transform = mask_flip -%}{%- endif -%}
  {%- elsif mask_rotate -%}
    {%- assign mask_transform = 'rotate(180deg)' -%}
  {%- endif -%}

  {%- comment -%} A scale step is sized by dm-theme.css via the data-attr; any
    other value is an inline height — bare digits get `px`, anything already
    carrying a unit passes through (mirrors render.tsx). {%- endcomment -%}
  {%- if h_scales == blank -%}{%- assign h_scales = 'sm,md,lg,xl' | split: ',' -%}{%- endif -%}
  {%- assign mask_height_attr = '' -%}
  {%- assign mask_height_style = '' -%}
  {%- if h_scales contains mask_height -%}
    {%- assign mask_height_attr = mask_height -%}
  {%- elsif mask_height != blank -%}
    {%- assign mask_height_num = mask_height | times: 1 -%}
    {%- if mask_height_num > 0 -%}
      {%- capture mask_height_style -%}height: {{ mask_height_num }}px;{%- endcapture -%}
    {%- else -%}
      {%- capture mask_height_style -%}height: {{ mask_height }};{%- endcapture -%}
    {%- endif -%}
  {%- endif -%}

  {%- capture mask_style -%}{{ mask_height_style }}{%- if mask_transform != blank -%}transform: {{ mask_transform }};{%- endif -%}{%- endcapture -%}

  <svg
    viewBox="{{ mask_view_box }}"
    preserveAspectRatio="{{ mask_par }}"
    {% if mask_height_attr != blank %}data-mask-height="{{ mask_height_attr }}"{% endif %}
    {% if mask_style != blank %}style="{{ mask_style }}"{% endif %}
  >{%- if mask_scale_x != blank -%}<g transform="scale({{ mask_scale_x }},1)">{{ mask_body }}</g>{%- else -%}{{ mask_body }}{%- endif -%}</svg>
{%- endif -%}
